# ── MongoDB ───────────────────────────────────────────────────────
# Local dev (docker compose mongo service):
MONGODB_URI=mongodb://mongo:27017/docuguard
MONGODB_DB_NAME=docuguard
# Production (MongoDB Atlas) — replace the line above with:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/docuguard

# ── Redis (Celery broker + JWT blacklist) ─────────────────────────
REDIS_URL=redis://redis:6379/0

# ── AWS ───────────────────────────────────────────────────────────
# Textract OCR fallback uses sigv4 keys (leave blank if you don't need it):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Bedrock auth: a Bedrock API key (bearer token, starts with "ABSK"). boto3 reads it
# from AWS_BEARER_TOKEN_BEDROCK. (Alternatively, use the sigv4 keys above.)
AWS_BEARER_TOKEN_BEDROCK=
# Use an inference-profile ID (us. prefix). Enable model access in the Bedrock console.
# Haiku 4.5 = fast/cheap; us.anthropic.claude-sonnet-4-6 = higher quality.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-1

# ── Local filesystem storage (NO S3) ──────────────────────────────
LOCAL_STORAGE_DIR=./storage

# ── JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))" ──
JWT_SECRET_KEY=replace_with_a_32+_character_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Field encryption — generate with:
#    python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" ──
FIELD_ENCRYPTION_KEY=replace_with_a_generated_fernet_key

# ── App ───────────────────────────────────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173
